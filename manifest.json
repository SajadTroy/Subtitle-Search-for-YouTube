{
  "manifest_version": 3,
  "name": "Subtitle Search for YouTube",
  "version": "1.0",
  "description": "Search through a YouTube video's subtitles and jump to exact timestamps.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "src/bmcbrand/SVG_Files/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
